# Copy to .env on the server. Never commit the filled version.

# Postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://pcport:change-me@db:5432/pcport

# Let's Encrypt via Cloudflare DNS-01
ACME_EMAIL=you@example.com
CF_DNS_API_TOKEN=cloudflare-token-with-dns-edit-on-pcport.org

# Shared secret the scraper uses to trigger revalidation
REVALIDATE_TOKEN=generate-a-long-random-string

# GitHub API — 5000 req/h authenticated, far above what ingestion needs
GITHUB_TOKEN=

# IGDB (Twitch) for cover art and screenshots. Free dev key.
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
